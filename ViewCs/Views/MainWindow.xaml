
<Window x:Class="ViewCs.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ViewCs"
    Title="MainWindow"
    Height="512" Width="440"
>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool2Visible" />
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Run">
        <MenuItem Header="Run _Command"
            Command="{Binding RunModelTaskCommand}"
        />
        <MenuItem Header="Clear Text"
            Command="{Binding ClearTextCommand}"
        />
      </MenuItem>
    </Menu>

    <StackPanel Orientation="Vertical">
      <StackPanel Orientation="Horizontal">
        <Label Margin="8,8,8,8" Content="_Command :" />
        <TextBox x:Name="txtCommand"
            Margin="8,8,8,8" Width="320"
        />
      </StackPanel>
      <Button
          Margin="8,8,8,8" Width="96"
          Content="Run"
          HorizontalAlignment="Left"
          Command="{Binding RunModelTaskCommand}"
      />
      <ProgressBar
          Margin="8,8,8,8" Height="16"
          Visibility="{Binding IsRunning, Converter={StaticResource Bool2Visible}, Mode=OneWay}"
          IsIndeterminate="True"
      />
      <TextBox x:Name="txtOutput"
          Margin="8,8,8,8" Height="320"
          IsEnabled="False"
          Text="{Binding ResultText, Mode=OneWay}"
      />
      <TextBox
          Margin="8,8,8,8"
          IsEnabled="False"
          Text="{Binding ReturnCode, StringFormat='Return Code : {0}', Mode=OneWay}"
      />
    </StackPanel>
  </DockPanel>

</Window>
