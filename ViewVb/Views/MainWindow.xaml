
<Window x:Class="Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ViewVb"
    Title="MainWindow"
>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="mnuFileExit_Click" />
      </MenuItem>
      <MenuItem Header="_Run">
        <MenuItem Header="Run _Command" Click="mnuRunCommand_Click" />
      </MenuItem>
    </Menu>

    <StackPanel Orientation="Vertical">
      <StackPanel Orientation="Horizontal">
        <Label Margin="8,8,8,8" Content="_Command :" />
        <TextBox x:Name="txtCommand"
            Margin="8,8,8,8" Width="320"
        />
      </StackPanel>
      <Button
          Margin="8,8,8,8" Width="96"
          Content="Run"
          HorizontalAlignment="Left"
          Click="btnRun_Click"
      />
      <TextBox x:Name="txtOutput"
          Margin="8,8,8,8" Height="320"
          Text="Outputs"
      />
    </StackPanel>
  </DockPanel>

</Window>
